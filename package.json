{
  "name": "dweis-next",
  "displayName": "DWeis Next",
  "version": "1.9.7",
  "private": true,
  "description": "DWeis Next — desktop AI agent for local work, custom models, and automation.",
  "homepage": "https://dweis.ai/",
  "bugs": {
    "url": "https://github.com/3d-jq/DWeis-Next/issues"
  },
  "license": "Apache-2.0",
  "author": "DWeis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3d-jq/DWeis-Next.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "bootstrap": "node --experimental-strip-types ./scripts/bootstrap.ts",
    "postinstall": "node --experimental-strip-types ./scripts/download-electron.ts && node --experimental-strip-types ./scripts/download-oo.ts && node --experimental-strip-types ./scripts/download-skills.ts && node --experimental-strip-types ./scripts/download-ripgrep.ts && node --experimental-strip-types ./scripts/build-agent-tool-runtime.ts",
    "predev": "node --experimental-strip-types ./scripts/check-oo.ts",
    "dev": "node --experimental-strip-types ./scripts/dev.ts",
    "dev:worktree": "node --experimental-strip-types ./scripts/dev-worktree.ts",
    "dev:no-electron": "vite --mode no-electron",
    "build": "pnpm run build:app",
    "ts-check": "tsgo -p tsconfig.json --incremental false",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run",
    "verify:skills-lock": "node scripts/verify-skills-lock.mjs",
    "build:app": "pnpm run ts-check && vite build",
    "prepare:binaries": "node --experimental-strip-types scripts/prepare-binaries.ts",
    "build:electron": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --publish never",
    "build:mac": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --mac --publish never",
    "build:win": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --win --publish never",
    "build:linux": "pnpm run build:app && pnpm run prepare:binaries && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.17.13",
    "diff": "9.0.0",
    "electron-updater": "6.8.9",
    "playwright-core": "1.62.0",
    "react-diff-view": "3.3.3",
    "unbash": "4.0.4",
    "wiki-graph": "0.4.1",
    "wiki-graph-core": "0.4.1"
  },
  "devDependencies": {
    "@electron-internal/extract-zip": "1.0.2",
    "@electron/get": "5.0.0",
    "@iconify-icons/simple-icons": "1.2.74",
    "@iconify-icons/tabler": "1.2.95",
    "@iconify/types": "2.0.0",
    "@oomol/connection": "0.2.28",
    "@oomol/connection-electron-adapter": "0.2.12",
    "@opencode-ai/plugin": "1.17.13",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/vite": "4.3.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260611.2",
    "@univerjs/core": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@vitejs/plugin-react": "6.0.2",
    "ai": "6.0.202",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx-preview": "0.3.7",
    "electron": "42.4.0",
    "electron-builder": "26.15.2",
    "franc-min": "6.2.0",
    "happy-dom": "20.11.1",
    "js-yaml": "^4.3.1",
    "jszip": "3.10.1",
    "lucide-react": "1.17.0",
    "motion": "12.40.0",
    "opencode-ai": "1.17.13",
    "oxfmt": "0.49.0",
    "oxlint": "1.69.0",
    "pdfjs-dist": "5.4.296",
    "plist": "5.0.0",
    "radix-ui": "1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "read-excel-file": "9.2.0",
    "rolldown": "1.0.3",
    "rxjs": "7.8.2",
    "shiki": "3.23.0",
    "sonner": "2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tar": "^7.5.21",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "use-stick-to-bottom": "1.1.6",
    "vite": "8.0.16",
    "vite-plugin-electron": "0.29.1",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@9.14.4",
  "pnpm": {
    "overrides": {
      "js-yaml@^4": "^4.3.1",
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^2": "2.1.4",
      "brace-expansion@^5": "5.0.9",
      "fast-uri@^3": "^3.1.5",
      "postcss@^8": "^8.5.18",
      "undici@^6": "^6.28.0",
      "undici@^7": "^7.29.0",
      "nanoid@^5": "^5.1.16",
      "tar@^7": "^7.5.21",
      "mermaid@^11": "^11.16.1",
      "dompurify@^3": "^3.4.13"
    }
  }
}
